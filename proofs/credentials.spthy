theory Threnody_Credentials
begin

/*
 * Symbolic model of Threnody's zero-knowledge credentials
 * (docs/appendix-o-credentials.md): blind issuance with an ML-DSA receipt,
 * then selective disclosure bound to a verifier's nonce.
 *
 * Abstractions:
 * - Blind BBS issuance: the holder commits to its link secret (the
 *   commitment hides it: no destructor) and the issuer signs the
 *   attributes over the commitment.
 * - A presentation is zkp(sig, header, a1, a2, link, blind, binding). It
 *   has no destructor for the hidden witnesses, so it shows only the
 *   header, the disclosed attribute a1 and the binding, and building one
 *   that verifies needs every witness: soundness and zero knowledge,
 *   idealised.
 *   Unlinkability is an equivalence property and is not modelled.
 * - "BBS broken" (a quantum or discrete-log adversary) leaks the issuer's
 *   BBS key. ML-DSA receipts use the issuer's separate post-quantum key,
 *   which only a long-term key reveal leaks.
 * - Requests travel in Threnody sessions (a secure channel); answers
 *   cross the network, with the hidden attribute encrypted, so only the
 *   ML-DSA receipt authenticates them.
 */

builtins: hashing, signing, symmetric-encryption

functions: bbspk/1, commit/2, bsign/3,
           zkp/7, zkcheck/2, zkhdr/1, zkattr/1, zkbind/1
equations:
  zkcheck(zkp(bsign(<hd, a1, a2>, commit(l, r), sk), hd, a1, a2, l, r, b), bbspk(sk)) = true,
  zkhdr(zkp(s, hd, a1, a2, l, r, b)) = hd,
  zkattr(zkp(s, hd, a1, a2, l, r, b)) = a1,
  zkbind(zkp(s, hd, a1, a2, l, r, b)) = b

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

// An issuer: a BBS key and an ML-DSA key, both bound to its identity
// (the issuer id pins them; Appendix O).
rule Issuer_Keys:
  [ Fr(~bbs), Fr(~pq) ]
  --[ Issuer($I) ]->
  [ !BbsKey($I, ~bbs), !PqKey($I, ~pq), !IssuerPub($I, bbspk(~bbs), pk(~pq)),
    Out(<bbspk(~bbs), pk(~pq)>) ]

// A classical break of BBS: the adversary learns the BBS key.
rule Break_Bbs:
  [ !BbsKey(I, k) ] --[ BbsBroken(I) ]-> [ Out(k) ]

// Compromise of the issuer's post-quantum key.
rule Reveal_Pq:
  [ !PqKey(I, k) ] --[ PqRevealed(I) ]-> [ Out(k) ]

// The holder's device is compromised: its link secret and blinding leak.
// (With the session key below, that is everything the device holds.)
rule Reveal_Link:
  [ !Link(H, l, r) ] --[ LinkRevealed(H) ]-> [ Out(<l, r>) ]

// The issuance session's key leaks (it protects the hidden attribute in
// transit, not the credential's authenticity).
rule Reveal_Session:
  [ !SessKey(H, k) ] --[ SessionRevealed(H) ]-> [ Out(k) ]

// Holder: a fresh link secret, committed, sent with a key for the answer
// over the (confidential) session. The answer itself crosses the network,
// so only the ML-DSA receipt authenticates it.
rule Holder_Request:
  [ Fr(~l), Fr(~r), Fr(~k) ]
  --[ Requested($H, $I, commit(~l, ~r)) ]->
  [ HolderWait($H, $I, ~l, ~r, ~k), !Link($H, ~l, ~r), !SessKey($H, ~k),
    Sec($H, $I, <commit(~l, ~r), ~k>) ]

// Issuer: signs a disclosed attribute a1 and a hidden one a2 (fresh, so
// its secrecy can be stated) over the commitment, with an ML-DSA receipt.
rule Issuer_Issue:
  let hd = <'header', $I, $schema>
      bs = bsign(<hd, $a1, ~a2>, c, bbs)
      receipt = sign(<'receipt', hd, $a1, ~a2, c, bs>, pq)
  in
  [ Sec(H, $I, <c, k>), !BbsKey($I, bbs), !PqKey($I, pq), Fr(~a2) ]
  --[ Issued($I, H, hd, $a1, ~a2), HiddenAttr(~a2) ]->
  [ Out(<hd, $a1, senc(~a2, k), bs, receipt>) ]

// Holder: checks the receipt against the pinned ML-DSA key, and the BBS
// signature by forming a proof that verifies.
rule Holder_Finish:
  let c = commit(l, r)
  in
  [ HolderWait(H, I, l, r, k), !IssuerPub(I, bpk, ppk),
    In(<hd, a1, senc(a2, k), bs, receipt>) ]
  --[ Eq(verify(receipt, <'receipt', hd, a1, a2, c, bs>, ppk), true),
      Eq(zkcheck(zkp(bs, hd, a1, a2, l, r, 'check'), bpk), true),
      HolderAccepts(H, I, hd, a1, a2) ]->
  [ !Cred(H, I, bs, hd, a1, a2, l, r) ]

// Verifier: asks for a schema with a fresh nonce (the binding).
rule Verifier_Ask:
  [ Fr(~n) ]
  --[ Ask($V, ~n) ]->
  [ VerifierWait($V, $I, $schema, ~n), Out(<$schema, ~n>) ]

// Holder: proves a1 only, bound to the verifier's nonce. Sent in the
// clear: everything it shows is what the adversary may learn.
rule Holder_Present:
  [ !Cred(H, I, bs, hd, a1, a2, l, r), In(n) ]
  --[ Presented(H, I, a1, n) ]->
  [ Out(zkp(bs, hd, a1, a2, l, r, n)) ]

rule Verifier_Accept:
  [ VerifierWait(V, I, schema, n), !IssuerPub(I, bpk, ppk), In(p) ]
  --[ Eq(zkcheck(p, bpk), true),
      Eq(zkhdr(p), <'header', I, schema>),
      Eq(zkbind(p), n),
      VerifierAccepts(V, I, zkattr(p), n) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex V I a1 n #i. VerifierAccepts(V, I, a1, n) @ #i
    & not (Ex X #x. BbsBroken(X) @ #x)
    & not (Ex X #x. PqRevealed(X) @ #x)
    & not (Ex X #x. LinkRevealed(X) @ #x)"

// A holder accepts only credentials the issuer really issued to it, even
// when BBS is broken: the ML-DSA receipt is post-quantum.
lemma issuance_authentic:
  "All H I hd a1 a2 #i. HolderAccepts(H, I, hd, a1, a2) @ #i ==>
      (Ex H2 #j. Issued(I, H2, hd, a1, a2) @ #j & #j < #i)
    | (Ex #r. PqRevealed(I) @ #r & #r < #i)"

// Soundness and no replay: a verifier accepts a1 from issuer I for its
// nonce only if an honest holder of a credential I issued with a1
// presented it for that very nonce, unless BBS was broken or that holder's
// link secret leaked.
lemma presentation_sound:
  "All V I a1 n #i. VerifierAccepts(V, I, a1, n) @ #i ==>
      (Ex H #j. Presented(H, I, a1, n) @ #j & #j < #i)
    | (Ex #x. BbsBroken(I) @ #x)
    | (Ex H #x. LinkRevealed(H) @ #x)"

// What was presented was issued.
lemma presented_was_issued:
  "All H I a1 n #i. Presented(H, I, a1, n) @ #i ==>
      (Ex H2 hd a2 #j. Issued(I, H2, hd, a1, a2) @ #j & #j < #i)
    | (Ex #r. PqRevealed(I) @ #r)"

// The issuer never learns the holder's link secret, nor does anyone else.
lemma link_secrecy:
  "All H I c l r #i #k. Requested(H, I, c) @ #i & c = commit(l, r) & K(l) @ #k ==>
      (Ex #x. LinkRevealed(H) @ #x)"

// Selective disclosure: a hidden attribute never leaks through
// presentations (only a1 is disclosed). It leaks only from the holder's
// device or the issuance session.
lemma hidden_attribute_secrecy:
  "All I H hd a1 a2 #i #k. Issued(I, H, hd, a1, a2) @ #i & K(a2) @ #k ==>
      (Ex #x. LinkRevealed(H) @ #x) | (Ex #x. SessionRevealed(H) @ #x)"

// The exceptions are real: a broken BBS key forges presentations, and a
// leaked link secret lets someone else present a stolen credential.
lemma sanity_bbs_break_forges:
  exists-trace
  "Ex V I a1 n #i #x. VerifierAccepts(V, I, a1, n) @ #i & BbsBroken(I) @ #x
    & not (Ex H #j. Presented(H, I, a1, n) @ #j)"

// Forging an issuance takes both of the issuer's keys: the ML-DSA receipt
// and the BBS signature are each checked (issuance_authentic shows a BBS
// break alone is not enough).
lemma sanity_forged_issuance_needs_both_keys:
  exists-trace
  "Ex H I hd a1 a2 #i #r #x #s. HolderAccepts(H, I, hd, a1, a2) @ #i
    & PqRevealed(I) @ #r & BbsBroken(I) @ #x & SessionRevealed(H) @ #s
    & not (Ex H2 #j. Issued(I, H2, hd, a1, a2) @ #j)"

lemma sanity_stolen_device_presents:
  exists-trace
  "Ex V I a1 n H #i #x #s. VerifierAccepts(V, I, a1, n) @ #i
    & LinkRevealed(H) @ #x & SessionRevealed(H) @ #s
    & not (Ex H #j. Presented(H, I, a1, n) @ #j)
    & not (Ex X #y. BbsBroken(X) @ #y)"

end
