    <!-- Tertiary -->
    <color name="md_sys_color_tertiary">#FF7C567F</color>
    <color name="md_sys_color_on_tertiary">#FFFFFFFF</color>
    <color name="md_sys_color_tertiary_container">#FFFFD9F9</color>
    <color name="md_sys_color_on_tertiary_container">#FF301433</color>

    <!-- Error -->
    <color name="md_sys_color_error">#FFBA1A1A</color>
    <color name="md_sys_color_on_error">#FFFFFFFF</color>
    <color name="md_sys_color_error_container">#FFFFDAD6</color>
    <color name="md_sys_color_on_error_container">#FF410002</color>

    <!-- Surface -->
    <color name="md_sys_color_surface">#FFFFFFFF</color>
    <color name="md_sys_color_on_surface">#FF1B1B1F</color>
