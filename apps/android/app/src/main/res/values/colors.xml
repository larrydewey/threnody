<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Color Roles - Light Theme -->
    <!-- Primary -->
    <color name="md_sys_color_primary">#FF4A4FC4</color>
    <color name="md_sys_color_on_primary">#FFFFFFFF</color>
    <color name="md_sys_color_primary_container">#FFE8E8FF</color>
    <color name="md_sys_color_on_primary_container">#FF000040</color>

    <!-- Secondary -->
    <color name="md_sys_color_secondary">#FF5B5E7E</color>
