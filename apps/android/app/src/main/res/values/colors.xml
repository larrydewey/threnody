    <!-- Outline -->
    <color name="md_sys_color_outline">#FF767680</color>
    <color name="md_sys_color_outline_variant">#FFC5C5CF</color>

    <!-- Inverse -->
    <color name="md_sys_color_inverse_surface">#FF303036</color>
    <color name="md_sys_color_inverse_on_surface">#FFF3F0F4</color>
    <color name="md_sys_color_inverse_primary">#FFCFCFFF</color>

    <!-- Shadow / Scrim -->
    <color name="md_sys_color_shadow">#FF000000</color>
    <color name="md_sys_color_scrim">#FF000000</color>

    <!-- Custom Threnody colors mapped to M3 roles -->
    <color name="background">@color/md_sys_color_surface</color>
    <color name="surface">@color/md_sys_color_surface</color>
    <color name="surface_variant">@color/md_sys_color_surface_container_high</color>
    <color name="surface_container">@color/md_sys_color_surface_container</color>
    <color name="surface_container_low">@color/md_sys_color_surface_container_low</color>
    <color name="bar">@color/md_sys_color_surface</color>
    <color name="sheet">@color/md_sys_color_surface_container_low</color>
    <color name="field">@color/md_sys_color_surface_container_highest</color>
    <color name="text">@color/md_sys_color_on_surface</color>
    <color name="text_secondary">@color/md_sys_color_outline</color>
    <color name="muted">@color/md_sys_color_outline</color>
    <color name="divider">@color/md_sys_color_outline_variant</color>
    <color name="accent">@color/md_sys_color_primary</color>
    <color name="on_accent">@color/md_sys_color_on_primary</color>

    <!-- Chat bubbles -->
    <color name="bubble_in">@color/md_sys_color_surface_container_high</color>
    <color name="bubble_out">@color/md_sys_color_primary</color>
    <color name="on_bubble_out">@color/md_sys_color_on_primary</color>

    <!-- Status -->
    <color name="online">#FF2E9E5B</color>
    <color name="warning">@color/md_sys_color_error</color>

    <!-- Sensitive photo cover -->
    <color name="cover">#FF1D1D25</color>
    <color name="cover_edge">#FF3D3D4A</color>
    <color name="on_cover">@color/md_sys_color_on_surface</color>

    <!-- Legacy compat -->
    <color name="primary">@color/md_sys_color_primary</color>
    <color name="on_primary">@color/md_sys_color_on_primary</color>
    <color name="primary_container">@color/md_sys_color_primary_container</color>
    <color name="on_primary_container">@color/md_sys_color_on_primary_container</color>
