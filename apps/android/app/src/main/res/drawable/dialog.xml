<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog: a rounded card in the theme's sheet colour, set in from the screen's edges -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp"
    android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/sheet" />
        <corners android:radius="28dp" />
    </shape>
</inset>
