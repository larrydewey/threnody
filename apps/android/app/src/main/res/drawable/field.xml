<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 filled text field -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/md_sys_color_surface_container_highest" />
        <corners android:radius="16dp" />
        <stroke
            android:width="1dp"
            android:color="@color/md_sys_color_outline_variant" />
        <padding
            android:left="16dp"
            android:top="12dp"
            android:right="16dp"
            android:bottom="12dp" />
    </shape>
</inset>